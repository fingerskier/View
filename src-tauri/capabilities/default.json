{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main viewer window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "opener:allow-open-url",
    {
      "identifier": "opener:allow-open-path",
      "allow": [{ "path": "**/*.html" }, { "path": "**/*.htm" }, { "path": "**/*.xhtml" }]
    }
  ]
}
